# Backend environment variables
# Copy this file to .env and fill in real values.

# PostgreSQL connection string (Neon or local Postgres)
# Example Neon:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"
# Example local:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/greencommute"
DATABASE_URL="postgresql://neondb_owner"

# JWT secret used to sign/verify tokens
JWT_SECRET="change-me"

# Optional
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (e.g. your Vercel URL).
# Leave unset to allow all origins (fine for local dev only).
# CORS_ORIGIN="https://your-app.vercel.app"
